{
  "name": "tickmark",
  "version": "0.2.0",
  "private": true,
  "description": "The list of documents a client owes you, and a tick as each one arrives.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "check:container": "node tools/check-container.mjs",
    "check:pages": "node tools/check-pages.mjs",
    "check:gateway": "node tools/preview-gateway.mjs tmp-gateway && node tools/check-pages.mjs tmp-gateway",
    "check:site": "node tools/check-site.mjs",
    "snapshot": "node tools/snapshot.mjs",
    "reset-password": "node tools/reset-password.mjs",
    "backup": "node tools/backup.mjs",
    "bench": "node tools/bench.mjs",
    "bench:breakdown": "node tools/bench-breakdown.mjs",
    "bench:gzip": "node tools/bench-gzip.mjs",
    "find:unused": "node tools/find-unused.mjs",
    "tables": "node tools/tables.mjs",
    "probe:repeats": "node tools/probe-repeats.mjs",
    "check:style": "node tools/check-style.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "preview:gateway": "node tools/preview-gateway.mjs",
    "check:nav": "node tools/check-nav.mjs",
    "transcript": "node tools/smtp-transcript.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
